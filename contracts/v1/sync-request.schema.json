{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aw-telegram.invalid/contracts/v1/sync-request.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "sequence": {
      "$ref": "https://aw-telegram.invalid/contracts/v1/shared.schema.json#/$defs/Counter"
    },
    "summaries": {
      "type": "array",
      "items": {
        "$ref": "https://aw-telegram.invalid/contracts/v1/shared.schema.json#/$defs/DaySummary"
      },
      "minItems": 0,
      "maxItems": 7
    },
    "live": {
      "$ref": "https://aw-telegram.invalid/contracts/v1/shared.schema.json#/$defs/LiveState"
    },
    "acks": {
      "type": "array",
      "items": {
        "$ref": "https://aw-telegram.invalid/contracts/v1/shared.schema.json#/$defs/Ack"
      },
      "minItems": 0,
      "maxItems": 100
    }
  },
  "required": [
    "schemaVersion",
    "sequence",
    "acks"
  ],
  "additionalProperties": false
}
